# Digital wallet (event-sourced, Kafka-backed) environment variables.
#
# Copy this file to `.env` and fill in your local values, or export the
# variables directly. Defaults shown after the `#` are what the service
# falls back to when the variable is unset.

# Kafka (the command/event log). Brokers is comma-separated.
KAFKA_BROKERS=localhost:9094           # default localhost:9092 (compose host listener: 9094)
KAFKA_PARTITIONS=12                    # shard count used when creating topics; default 12
KAFKA_REPLICATION_FACTOR=1             # 1 for local dev; 3 in production; default 1

# Postgres — required for gateway/saga/projector modes (the command-processor
# does not use it). Not required for `--mode=command-processor` or `--mode=seed`.
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable

# Gateway (HTTP / push model):
PORT=8080                              # default 8080
GATEWAY_WAIT_TIMEOUT=5s                # push deadline before returning 202; default 5s
SHUTDOWN_TIMEOUT=10s                   # graceful shutdown deadline; default 10s

# Logging:
LOG_LEVEL=info                         # debug | info | warn | error; default info
LOG_JSON=true                          # true => JSON; false => text; default true

# Postgres connection pool (defaults shown):
DB_MAX_OPEN_CONNS=10                   # default 10
DB_MAX_IDLE_CONNS=5                    # default 5
DB_CONN_MAX_LIFETIME=30m               # default 30m
DB_PING_TIMEOUT=5s                     # default 5s

# Integration tests spin up their own Kafka + Postgres via testcontainers, so
# they need a working Docker daemon. With colima/podman, also set:
#   DOCKER_HOST=unix://$HOME/.colima/default/docker.sock
#   TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock
